# =============================================================================
# Trading Scanner Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Database ---
DATABASE_URL=postgresql://scanner:scanner@localhost:5432/trading_scanner

# --- Market Data Provider ---
# Options: yahoo, custom
MARKET_DATA_PROVIDER=yahoo

# --- Exchange & Market ---
MARKET=NSE
TIMEZONE=Asia/Kolkata

# --- Liquidity Filters ---
MIN_PRICE=50
MIN_AVG_VOLUME=100000
MIN_AVG_TRADED_VALUE=5000000

# --- Risk Management ---
ACCOUNT_SIZE=100000
RISK_PER_TRADE=0.0075
MAX_PORTFOLIO_RISK=0.03
MAX_POSITIONS=5
MAX_SINGLE_POSITION_PCT=0.25

# --- Strategy: TREND_PULLBACK_V1 ---
MIN_RR=2.0
MIN_SCORE=70
ATR_STOP_MULTIPLIER=1.5
ATR_TARGET_MULTIPLIER=3.0

# --- Notifications ---
# Options: console, email, telegram
NOTIFICATION_PROVIDER=console

# SMTP (if using email)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TO=

# Telegram (if using telegram)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Broker Integration ---
# DANGER: Only enable after thorough paper trading
LIVE_TRADING_ENABLED=false
# BROKER_API_KEY=
# BROKER_API_SECRET=

# --- Logging ---
LOG_LEVEL=INFO
